[Desktop Entry]
Type=Application
Name=L-Shell
GenericName=Desktop Shell
Comment=A macOS Tahoe–style desktop shell for Wayland.
Exec=l-shell --daemon
Icon=l-shell
Terminal=false
Categories=Settings;DesktopSettings;
StartupNotify=false
Actions=Settings;
Keywords=desktop;shell;wayland;settings;system;

[Desktop Action Settings]
Name=System Settings
Exec=sh -c "l-shell msg settings-open || { l-shell --daemon && l-shell msg settings-open; }"
